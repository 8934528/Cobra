<Window x:Class="Cobra.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:Cobra.UI.Views"
        xmlns:proj="clr-namespace:Cobra.Core.ProjectSystem"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainWindow}"
        d:DesignHeight="900" d:DesignWidth="1400"
        Background="#1e1e1e"
        Icon="/Assets/AppIcon.png"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35" 
                      ResizeBorderThickness="5" 
                      GlassFrameThickness="0" 
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="CommonRoundedButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:TitleBarControl Grid.Row="0" 
                               NewProjectClicked="OnNewProjectClicked"
                               OpenProjectClicked="OnOpenProjectClicked"
                               ExitClicked="OnExitClicked"
                               PreferencesClicked="OnPreferencesClicked"
                               SettingsClicked="OnSettingsClicked"
                               ToggleFullScreenClicked="OnToggleFullScreenClicked"
                               ResetLayoutClicked="OnResetLayoutClicked"
                               RecentProjectsClicked="OnRecentProjectsClicked"
                               ProjectSettingsClicked="OnProjectSettingsClicked"
                               BuildClicked="OnBuildClicked"
                               ExportClicked="OnExportClicked"
                               PackageManagerClicked="OnPackageManagerClicked"
                               ExtensionsClicked="OnExtensionsClicked"
                               OpenTerminalClicked="OnOpenTerminalClicked"
                               RunCommandClicked="OnRunCommandClicked"
                               DocumentationClicked="OnDocumentationClicked"
                               AboutClicked="OnAboutClicked"
                               SettingsIconClicked="OnSettingsIconClicked"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,24,30,24" MaxWidth="1280">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Cobra IDE" 
                                   FontSize="16" 
                                   Foreground="White" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Create, run, and package Python games with Pygame, Panda3D, and Ursina." 
                                   FontSize="12" 
                                   Foreground="#aaaaaa"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="OnNewProjectClicked"
                                Background="#ff8c00"
                                Foreground="White"
                                Height="34"
                                Padding="14,0"
                                Margin="0,0,10,0"
                                Style="{StaticResource CommonRoundedButtonStyle}"
                                ToolTip="New project (Ctrl+N)"
                                FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FolderPlus" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="New Project" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Click="OnOpenProjectClicked"
                                Background="#3c3c3c"
                                Foreground="White"
                                Height="34"
                                Padding="14,0"
                                Margin="0,0,10,0"
                                Style="{StaticResource CommonRoundedButtonStyle}"
                                ToolTip="Open project (Ctrl+O)"
                                FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FolderOpen" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Project" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Click="OnCheckPythonClicked"
                                Background="#2d2d30"
                                BorderBrush="#4c4c4c"
                                BorderThickness="1"
                                Foreground="White"
                                Width="34"
                                Height="34"
                                Margin="0,0,8,0"
                                Style="{StaticResource CommonRoundedButtonStyle}"
                                ToolTip="Check Python">
                            <iconPacks:PackIconMaterial Kind="LanguagePython" Width="15" Height="15" Foreground="#4ec9b0"/>
                        </Button>

                        <Button Click="OnSettingsIconClicked"
                                Background="#2d2d30"
                                BorderBrush="#4c4c4c"
                                BorderThickness="1"
                                Foreground="White"
                                Width="34"
                                Height="34"
                                Style="{StaticResource CommonRoundedButtonStyle}"
                                ToolTip="Settings">
                            <iconPacks:PackIconMaterial Kind="Cog" Width="15" Height="15"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Project Templates Showcase -->
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Project Templates" 
                                   FontSize="13" 
                                   Foreground="White" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>
                        <WrapPanel x:Name="TemplateShowcasePanel" Orientation="Horizontal"/>
                    </StackPanel>
                </Border>

                <!-- Recent Projects -->
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Recent Projects" 
                                       FontSize="13" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Click="OnOpenSelectedProject"
                                        Background="#ff8c00"
                                        Foreground="White"
                                        Height="28"
                                        Padding="12,0"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource CommonRoundedButtonStyle}"
                                        ToolTip="Open project"
                                        FontSize="12">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="CodeBraces" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Open Project" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnProjectSettingsClicked"
                                        Background="#3c3c3c"
                                        Foreground="White"
                                        Height="28"
                                        Padding="12,0"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource CommonRoundedButtonStyle}"
                                        ToolTip="Project settings"
                                        FontSize="12">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Tune" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Project Settings" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnRefreshClicked"
                                        Background="#3c3c3c"
                                        Foreground="White"
                                        Width="28"
                                        Height="28"
                                        Style="{StaticResource CommonRoundedButtonStyle}"
                                        ToolTip="Refresh list">
                                    <iconPacks:PackIconMaterial Kind="Refresh" Width="13" Height="13"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Background="#1e1e1e"
                                BorderBrush="#3c3c3c"
                                BorderThickness="1"
                                CornerRadius="3"
                                MinHeight="160"
                                MaxHeight="260">
                            <ListBox x:Name="RecentProjectsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="12"
                                     MouseDoubleClick="OnRecentProjectDoubleClick"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="OnProjectSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type proj:ProjectModel}">
                                        <Grid Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <iconPacks:PackIconMaterial Grid.Column="0" Kind="GamepadVariant" Width="15" Height="15" Foreground="#ff8c00" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#2d2d30" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Framework}" Foreground="#4ec9b0" FontSize="11"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding Path}" Foreground="#888888" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="4" Text="{Binding LastModified}" Foreground="#777777" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Python Environment & System Status -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Python Status" 
                                       FontSize="13" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="165"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Python Version:" Foreground="#aaaaaa" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PythonStatusText" Grid.Row="0" Grid.Column="1" Text="Checking..." Foreground="White" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="2D Framework:" Foreground="#aaaaaa" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Pygame (pygame-ce)" Foreground="#4ec9b0" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="3D Engines:" Foreground="#aaaaaa" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Panda3D, Ursina Engine" Foreground="#cccccc" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Projects:" Foreground="#aaaaaa" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProjectCountText" Grid.Row="3" Grid.Column="1" Text="0" Foreground="White" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Quick Workflow" 
                                       FontSize="13" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <StackPanel Margin="0,3" Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="LanguagePython" Width="14" Height="14" Foreground="#ff8c00" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="1. Create a project from a template" Foreground="#cccccc" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,3" Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Palette" Width="14" Height="14" Foreground="#ff8c00" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="2. Design scenes and edit Python code" Foreground="#cccccc" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,3" Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Bug" Width="14" Height="14" Foreground="#ff8c00" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="3. Run and debug your game" Foreground="#cccccc" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,3" Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="PackageVariantClosed" Width="14" Height="14" Foreground="#ff8c00" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="4. Package into a Windows executable" Foreground="#cccccc" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="ToastOverlay" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" Visibility="Collapsed">
            <Border Background="#2d2d30" CornerRadius="4" Padding="18,10" BorderBrush="#ff8c00" BorderThickness="1" SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial x:Name="ToastIcon" Kind="CheckCircle" Width="14" Height="14" Foreground="#4ec9b0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ToastMessage" Text="Project created!" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" Y="100"/>
            </Grid.RenderTransform>
        </Grid>
    </Grid>
</Window>
