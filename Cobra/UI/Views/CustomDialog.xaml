<Window x:Class="Cobra.UI.Views.CustomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        MinWidth="400"
        MaxWidth="600">

    <Window.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
    </Window.RenderTransform>

    <Border Background="#202024" 
            CornerRadius="8" 
            BorderBrush="#383840" 
            BorderThickness="1"
            Margin="24"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" 
                            Opacity="0.6" 
                            ShadowDepth="8"
                            Direction="270"
                            Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Border Grid.Row="0" 
                    Background="#18181b" 
                    CornerRadius="8,8,0,0"
                    BorderBrush="#2e2e33" 
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial x:Name="TitleIcon" 
                                                    Kind="Information" 
                                                    Width="14" 
                                                    Height="14" 
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="#cccccc"/>
                        <TextBlock x:Name="TitleText" 
                                Text="Dialog" 
                                Foreground="White" 
                                FontSize="12" 
                                Margin="4"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button x:Name="CloseButton"
                            HorizontalAlignment="Right"
                            Width="30"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border" Background="Transparent" CornerRadius="3">
                                    <iconPacks:PackIconMaterial Kind="Close" 
                                                               Width="14" 
                                                               Height="14" 
                                                               Foreground="#cccccc"
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#c42b1c"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- content -->
            <Border Grid.Row="1" Background="#202024" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="MessageText" 
                               Text="Message" 
                               Foreground="#e4e4e7" 
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>

                    <StackPanel x:Name="CustomContent" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- buttons -->
            <Border Grid.Row="2" 
                    Background="#18181b" 
                    CornerRadius="0,0,8,8" 
                    BorderBrush="#2e2e33"
                    BorderThickness="0,1,0,0"
                    Padding="15,12">
                <StackPanel x:Name="ButtonsPanel" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button x:Name="Button1" 
                            Content="OK"
                            Width="80"
                            Height="30"
                            Margin="5,0,0,0"
                            Background="#ff8c00"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontSize="12"
                            Click="Button_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border" 
                                        Background="{TemplateBinding Background}" 
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#e67e00"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="Button2" 
                            Content="Cancel"
                            Width="80"
                            Height="30"
                            Margin="5,0,0,0"
                            Background="#2b2b30"
                            Foreground="#f4f4f5"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontSize="12"
                            Visibility="Collapsed"
                            Click="Button_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border" 
                                        Background="{TemplateBinding Background}" 
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#383840"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
    
