<Page x:Class="Cobra.UI.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cobra.UI.Views"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1400">

    <Page.Resources>
        <!-- section header style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4ec9b0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,15"/>
        </Style>

        <!-- card style -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="20,15"/>
        </Style>

        <!-- setting row style -->
        <Style x:Key="SettingRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- label style -->
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- description style -->
        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- textbox style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#e0e0e0"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- consistent combobox style with fixed width -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.ColumnSpan="2"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" 
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <Grid>
                                                <ContentPresenter HorizontalAlignment="Left" 
                                                                  VerticalAlignment="Center"
                                                                  Margin="10,0,30,0"/>
                                                <Path x:Name="Arrow"
                                                      Fill="#e0e0e0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      Data="M0,0 L4,4 L8,0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#2d2d30"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="#252526"
                                        BorderBrush="#3c3c3c"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- checkbox style -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBoxBorder"
                                    Width="18" Height="18"
                                    Background="#1e1e1e"
                                    BorderBrush="#3c3c3c"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Margin="0,0,8,0">
                                <iconPacks:PackIconMaterial x:Name="CheckMark" 
                                                            Kind="Check" 
                                                            Width="12" 
                                                            Height="12" 
                                                            Foreground="#ff8c00"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#2d2d30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- button style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#ff8c00"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#005a9e"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeCobraryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4c4c4c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- slider style -->
        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="#ff8c00"/>
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- toggleswitch style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" 
                                Width="50" 
                                Height="26" 
                                Background="#3c3c3c" 
                                CornerRadius="3"
                                Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" Opacity="0.2"/>
                            </Border.Effect>
                            <Border x:Name="Thumb" 
                                    Width="22" 
                                    Height="22" 
                                    Background="#888888" 
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    Margin="2">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#ff8c00"/>
                                <Setter TargetName="Thumb" Property="Background" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                           Storyboard.TargetProperty="X"
                                                           To="24" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                           Storyboard.TargetProperty="X"
                                                           To="0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- scrollviewer style -->
        <Style x:Key="ModernScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- navigation button style -->
        <Style x:Key="NavButtonStyle" TargetType="Border">
            <Setter Property="Margin" Value="20,0,20,5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2d2d30"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <local:TitleBarControl Grid.Row="0"/>

        <!-- main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <!-- sidebar navigation -->
        <Border Grid.Column="0" Background="#252526">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,20,0,20">
                    <Border Background="#2d2d30" Margin="20,0,20,20" Padding="15" CornerRadius="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Configure your IDE" 
                                       Foreground="#888888" 
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- navigation items -->
                    <Border x:Name="NavGeneral" Style="{StaticResource NavButtonStyle}" Background="#2d2d30" MouseLeftButtonDown="NavItem_Click" Tag="General">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Cog" Width="16" Height="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="General" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Appearance, language and behavior" Foreground="#888888" FontSize="9" Margin="24,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="NavTheme" Style="{StaticResource NavButtonStyle}" Background="Transparent" MouseLeftButtonDown="NavItem_Click" Tag="Theme">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Palette" Width="16" Height="16" Foreground="#e0e0e0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Theme and Editor" Foreground="#e0e0e0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Colors, fonts and layout" Foreground="#888888" FontSize="9" Margin="24,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="NavPython" Style="{StaticResource NavButtonStyle}" Background="Transparent" MouseLeftButtonDown="NavItem_Click" Tag="Python">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="LanguagePython" Width="16" Height="16" Foreground="#e0e0e0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Python" Foreground="#e0e0e0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Interpreter and environment" Foreground="#888888" FontSize="9" Margin="24,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="NavEditor" Style="{StaticResource NavButtonStyle}" Background="Transparent" MouseLeftButtonDown="NavItem_Click" Tag="Editor">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="CodeBraces" Width="16" Height="16" Foreground="#e0e0e0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Editor" Foreground="#e0e0e0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Code editing and formatting" Foreground="#888888" FontSize="9" Margin="24,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="NavGameEngine" Style="{StaticResource NavButtonStyle}" Background="Transparent" MouseLeftButtonDown="NavItem_Click" Tag="GameEngine">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Gamepad" Width="16" Height="16" Foreground="#e0e0e0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Game Engine" Foreground="#e0e0e0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Scene and physics settings" Foreground="#888888" FontSize="9" Margin="24,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="NavTools" Style="{StaticResource NavButtonStyle}" Background="Transparent" MouseLeftButtonDown="NavItem_Click" Tag="Tools">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Wrench" Width="16" Height="16" Foreground="#e0e0e0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tools" Foreground="#e0e0e0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Terminal and external tools" Foreground="#888888" FontSize="9" Margin="24,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="NavExtensions" Style="{StaticResource NavButtonStyle}" Background="Transparent" MouseLeftButtonDown="NavItem_Click" Tag="Extensions">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Puzzle" Width="16" Height="16" Foreground="#e0e0e0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Extensions" Foreground="#e0e0e0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Manage plugins" Foreground="#888888" FontSize="9" Margin="24,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="NavKeymap" Style="{StaticResource NavButtonStyle}" Background="Transparent" MouseLeftButtonDown="NavItem_Click" Tag="Keymap">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Keyboard" Width="16" Height="16" Foreground="#e0e0e0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Keymap" Foreground="#e0e0e0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Keyboard shortcuts" Foreground="#888888" FontSize="9" Margin="24,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="NavAbout" Style="{StaticResource NavButtonStyle}" Background="Transparent" MouseLeftButtonDown="NavItem_Click" Tag="About">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Information" Width="16" Height="16" Foreground="#e0e0e0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="About" Foreground="#e0e0e0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Version and updates" Foreground="#888888" FontSize="9" Margin="24,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- separator -->
        <Border Grid.Column="1" Background="#3c3c3c"/>

        <!-- main content area -->
        <ScrollViewer Grid.Column="2" Style="{StaticResource ModernScrollViewerStyle}" x:Name="MainScrollViewer">
            <StackPanel Margin="30,20,30,30">

                <!-- header -->
                <TextBlock x:Name="MainHeader" 
                           FontSize="12" 
                           Foreground="White" 
                           FontWeight="Bold"
                           Margin="0,0,0,5">
                    <TextBlock.Inlines>
                        <Run Text="Settings"/>
                    </TextBlock.Inlines>
                </TextBlock>

                <TextBlock x:Name="SubHeader" Text="Customize your Cobra IDE experience" 
                           FontSize="12" 
                           Foreground="#888888"
                           Margin="0,0,0,30"/>

                <!-- content container -->
                <Grid x:Name="ContentContainer" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>

                    <!-- general section -->
                    <StackPanel x:Name="GeneralSection" Visibility="Visible">

                        <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- general settings card -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <!-- language setting -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Translate" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Language" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Select interface language" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" SelectedValue="{Binding Language, Mode=TwoWay}" SelectedValuePath="Content">
                                        <ComboBoxItem>English (US)</ComboBoxItem>
                                        <ComboBoxItem>Spanish</ComboBoxItem>
                                        <ComboBoxItem>French</ComboBoxItem>
                                        <ComboBoxItem>German</ComboBoxItem>
                                        <ComboBoxItem>Chinese</ComboBoxItem>
                                        <ComboBoxItem>Japanese</ComboBoxItem>
                                    </ComboBox>
                                </Grid>

                                <!-- startup behavior -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="RocketLaunch" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Startup Behavior" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="What to show on IDE startup" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" SelectedValue="{Binding StartupBehavior, Mode=TwoWay}" SelectedValuePath="Content">
                                        <ComboBoxItem>Show Dashboard</ComboBoxItem>
                                        <ComboBoxItem>Open Last Project</ComboBoxItem>
                                        <ComboBoxItem>Show Welcome Screen</ComboBoxItem>
                                        <ComboBoxItem>Empty Workspace</ComboBoxItem>
                                    </ComboBox>
                                </Grid>

                                <!-- auto save -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="ContentSave" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Auto Save" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Automatically save files" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="AutoSaveToggle" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AutoSave, Mode=TwoWay}" Checked="AutoSaveToggle_Checked" Unchecked="AutoSaveToggle_Unchecked"/>
                                    <ComboBox Grid.Column="2" x:Name="AutoSaveIntervalCombo" Width="150" Margin="15,0,0,0" Style="{StaticResource ModernComboBoxStyle}" SelectedValue="{Binding AutoSaveInterval, Mode=TwoWay}" SelectedValuePath="Content" SelectionChanged="AutoSaveIntervalCombo_SelectionChanged">
                                        <ComboBoxItem>Every 30 seconds</ComboBoxItem>
                                        <ComboBoxItem>Every 1 minute</ComboBoxItem>
                                        <ComboBoxItem>Every 5 minutes</ComboBoxItem>
                                        <ComboBoxItem>On focus loss</ComboBoxItem>
                                    </ComboBox>
                                </Grid>

                                <!-- check for updates -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Update" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Check for Updates" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Automatically check for updates" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"/>
                                    <Button Grid.Column="2" Content="Check Now" Width="100" Margin="15,0,0,0" 
                                            Style="{StaticResource SeCobraryButtonStyle}" HorizontalAlignment="Left" Click="CheckNowButton_Click"/>
                                </Grid>

                                <!-- telemetry -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="ChartLine" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Telemetry" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Send anonymous usage data" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Telemetry, Mode=TwoWay}"/>
                                </Grid>
                                
                                <!-- translation api key -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Translate" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Translation API Key" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="API Key for language translation services" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="TranslationKeyText" Text="{Binding TranslationApiKey, Mode=TwoWay}" Style="{StaticResource ModernTextBoxStyle}" TextChanged="GenericSetting_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- theme and editor section -->
                    <StackPanel x:Name="ThemeSection" Visibility="Collapsed">
                        <TextBlock Text="Theme and Editor" Style="{StaticResource SectionHeaderStyle}"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <!-- theme selection -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Palette" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Theme" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Choose your preferred theme" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="ThemeCombo" Style="{StaticResource ModernComboBoxStyle}" SelectedValue="{Binding Theme, Mode=TwoWay}" SelectedValuePath="Content" SelectionChanged="ThemeCombo_SelectionChanged">
                                        <ComboBoxItem>Dark (Default)</ComboBoxItem>
                                        <ComboBoxItem>Light</ComboBoxItem>
                                        <ComboBoxItem>High Contrast</ComboBoxItem>
                                        <ComboBoxItem>Monokai</ComboBoxItem>
                                        <ComboBoxItem>Solarized Dark</ComboBoxItem>
                                    </ComboBox>
                                </Grid>

                                <!-- accent color -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="PaletteSwatch" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Accent Color" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Primary UI accent color" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="3" Background="#ff8c00" Margin="0,0,5,0" Cursor="Hand" Tag="Orange" MouseLeftButtonDown="AccentColor_MouseLeftButtonDown">
                                            <Border.ToolTip>
                                                <ToolTip>Blue (Default)</ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                        <Border Width="30" Height="30" CornerRadius="3" Background="#28a745" Margin="0,0,5,0" Cursor="Hand" Tag="Green" MouseLeftButtonDown="AccentColor_MouseLeftButtonDown">
                                            <Border.ToolTip>
                                                <ToolTip>Green</ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                        <Border Width="30" Height="30" CornerRadius="3" Background="#dc3545" Margin="0,0,5,0" Cursor="Hand" Tag="Red" MouseLeftButtonDown="AccentColor_MouseLeftButtonDown">
                                            <Border.ToolTip>
                                                <ToolTip>Red</ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                        <Border Width="30" Height="30" CornerRadius="3" Background="#fd7e14" Margin="0,0,5,0" Cursor="Hand" Tag="Orange" MouseLeftButtonDown="AccentColor_MouseLeftButtonDown">
                                            <Border.ToolTip>
                                                <ToolTip>Orange</ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                        <Border Width="30" Height="30" CornerRadius="3" Background="#6f42c1" Margin="0,0,5,0" Cursor="Hand" Tag="Purple" MouseLeftButtonDown="AccentColor_MouseLeftButtonDown">
                                            <Border.ToolTip>
                                                <ToolTip>Purple</ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- font family -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="FormatFont" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Font Family" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Editor font family" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="FontFamilyCombo" Style="{StaticResource ModernComboBoxStyle}" SelectedValue="{Binding FontFamily, Mode=TwoWay}" SelectedValuePath="Content" SelectionChanged="FontFamilyCombo_SelectionChanged">
                                        <ComboBoxItem>Consolas</ComboBoxItem>
                                        <ComboBoxItem>Cascadia Code</ComboBoxItem>
                                        <ComboBoxItem>Fira Code</ComboBoxItem>
                                        <ComboBoxItem>JetBrains Mono</ComboBoxItem>
                                        <ComboBoxItem>Segoe UI</ComboBoxItem>
                                        <ComboBoxItem>Source Code Pro</ComboBoxItem>
                                        <ComboBoxItem>Tomorrow</ComboBoxItem>
                                    </ComboBox>
                                </Grid>

                                <!-- font size -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="FormatSize" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Font Size" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Editor font size in pixels" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="FontSizeSlider" Width="200" Minimum="10" Maximum="24" Value="{Binding FontSize, Mode=TwoWay}" Style="{StaticResource ModernSliderStyle}" ValueChanged="FontSizeSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding FontSize}" Foreground="#e0e0e0" Margin="15,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <!-- line spacing -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="FormatLineSpacing" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Line Spacing" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Line height multiplier" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="LineSpacingSlider" Width="200" Minimum="1" Maximum="2" Value="{Binding LineSpacing, Mode=TwoWay}" Style="{StaticResource ModernSliderStyle}" ValueChanged="LineSpacingSlider_ValueChanged"/>
                                        <TextBlock Text="{Binding LineSpacing, StringFormat=N1}" Foreground="#e0e0e0" Margin="15,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <!-- minimap -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Map" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Minimap" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Show code minimap" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="MinimapToggle" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShowMinimap, Mode=TwoWay}" Checked="MinimapToggle_Checked" Unchecked="MinimapToggle_Unchecked"/>
                                </Grid>

                                <!-- word wrap -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Wrap" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Word Wrap" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Wrap long lines" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="WordWrapToggle" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding WordWrap, Mode=TwoWay}" Checked="WordWrapToggle_Checked" Unchecked="WordWrapToggle_Unchecked"/>
                                </Grid>

                                <!-- line numbers -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="FormatListNumbered" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Line Numbers" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Show line numbers in editor" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="LineNumbersToggle" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShowLineNumbers, Mode=TwoWay}" Checked="LineNumbersToggle_Checked" Unchecked="LineNumbersToggle_Unchecked"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- python section -->
                    <StackPanel x:Name="PythonSection" Visibility="Collapsed">
                        <TextBlock Text="Python" Style="{StaticResource SectionHeaderStyle}"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <!-- python interpreter -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="LanguagePython" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Python Interpreter" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Path to Python executable" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding PythonInterpreter, Mode=TwoWay}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,10,0"/>
                                    <Button Grid.Column="2" x:Name="BrowsePythonButton" Content="Browse..." Style="{StaticResource SeCobraryButtonStyle}" Width="90" Click="BrowsePythonButton_Click"/>
                                </Grid>

                                <!-- default virtual environment -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Folder" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Virtual Environment" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Auto-create venv for new projects" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AutoCreateVenv, Mode=TwoWay}"/>
                                </Grid>

                                <!-- pip index -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="PackageVariant" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Pip Index URL" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Custom package index URL" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding PipIndexUrl, Mode=TwoWay}" Style="{StaticResource ModernTextBoxStyle}"/>
                                </Grid>

                                <!-- default packages -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="PackageVariantClosed" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Default Packages" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Auto-install for new projects" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding DefaultPackages, Mode=TwoWay}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,10,0"/>
                                    <Button Grid.Column="2" Content="Manage" Style="{StaticResource SeCobraryButtonStyle}" Width="90" Click="ManageDefaultPackagesButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- editor section -->
                    <StackPanel x:Name="EditorSection" Visibility="Collapsed">
                        <TextBlock Text="Editor" Style="{StaticResource SectionHeaderStyle}"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="AutoFix" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Auto Completion" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Enable code completion" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AutoCompletion, Mode=TwoWay}"/>
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="BugCheck" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Linting" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Enable code linting" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Linting, Mode=TwoWay}"/>
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="FormatIndentIncrease" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Format on Save" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Format Python files automatically on save" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding FormatOnSave, Mode=TwoWay}"/>
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Tab" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Tab Size" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Number of spaces per tab" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="TabSizeCombo" Style="{StaticResource ModernComboBoxStyle}" SelectedValue="{Binding TabSize, Mode=TwoWay}" SelectedValuePath="Content" SelectionChanged="GenericSetting_Changed">
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="4" IsSelected="True"/>
                                        <ComboBoxItem Content="6"/>
                                        <ComboBoxItem Content="8"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- game engine section -->
                    <StackPanel x:Name="GameEngineSection" Visibility="Collapsed">
                        <TextBlock Text="Game Engine" Style="{StaticResource SectionHeaderStyle}"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <!-- default resolution -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="AspectRatio" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Default Resolution" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Default game window size" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="ResolutionCombo" Style="{StaticResource ModernComboBoxStyle}" SelectedValue="{Binding DefaultResolution, Mode=TwoWay}" SelectedValuePath="Content" SelectionChanged="GenericSetting_Changed">
                                        <ComboBoxItem Content="800x600"/>
                                        <ComboBoxItem Content="1024x768"/>
                                        <ComboBoxItem Content="1280x720"/>
                                        <ComboBoxItem Content="1920x1080"/>
                                    </ComboBox>
                                </Grid>

                                <!-- fullscreen by default -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Fullscreen" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Fullscreen Default" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Start games in fullscreen" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="FullscreenToggle" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding FullscreenDefault, Mode=TwoWay}" Checked="GenericSetting_Changed" Unchecked="GenericSetting_Changed"/>
                                </Grid>

                                <!-- vsync -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Sync" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="VSync" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Enable vertical sync" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="VSyncToggle" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding VSync, Mode=TwoWay}" Checked="GenericSetting_Changed" Unchecked="GenericSetting_Changed"/>
                                </Grid>

                                <!-- frame rate -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Speedometer" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Frame Rate Limit" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Maximum FPS (0 = unlimited)" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="FrameRateSlider" Width="200" Minimum="0" Maximum="240" Value="{Binding FrameRateLimit, Mode=TwoWay}" Style="{StaticResource ModernSliderStyle}" ValueChanged="GenericSetting_Changed"/>
                                        <TextBlock Text="{Binding FrameRateLimit, StringFormat={}{0} FPS}" Foreground="#e0e0e0" Margin="15,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <!-- physics engine -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Atom" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Physics Engine" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Choose physics backend" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="PhysicsCombo" Style="{StaticResource ModernComboBoxStyle}" SelectedValue="{Binding PhysicsEngine, Mode=TwoWay}" SelectedValuePath="Content" SelectionChanged="GenericSetting_Changed">
                                        <ComboBoxItem Content="Pymunk"/>
                                        <ComboBoxItem Content="Box2D"/>
                                        <ComboBoxItem Content="None"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- tools section -->
                    <StackPanel x:Name="ToolsSection" Visibility="Collapsed">
                        <TextBlock Text="Tools" Style="{StaticResource SectionHeaderStyle}"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <!-- preferred terminal selector -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="ConsoleLine" Width="14" Height="14" Foreground="#4ec9b0" Margin="0,0,5,0"/>
                                            <TextBlock Text="Preferred Terminal" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Select default terminal shell (Git Bash or PowerShell)" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="PreferredTerminalCombo" Style="{StaticResource ModernComboBoxStyle}" SelectedValue="{Binding PreferredTerminal, Mode=TwoWay}" SelectedValuePath="Content" SelectionChanged="GenericSetting_Changed">
                                        <ComboBoxItem Content="Windows PowerShell"/>
                                        <ComboBoxItem Content="Git Bash"/>
                                        <ComboBoxItem Content="Command Prompt"/>
                                        <ComboBoxItem Content="Custom"/>
                                    </ComboBox>
                                </Grid>

                                <!-- terminal detection status -->
                                <Border Background="#1e1e1e" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="3" Padding="12,10" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="Installed Terminal Detection" Foreground="#bbbbbb" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TerminalDetectionSummary" Text="Checking installed terminals..." Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- terminal path -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Console" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Custom Terminal Path" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Path to custom terminal emulator executable" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="TerminalPathText" Text="{Binding TerminalPath, Mode=TwoWay}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,10,0" TextChanged="GenericSetting_Changed"/>
                                    <Button Grid.Column="2" x:Name="BrowseTerminalButton" Content="Browse..." Style="{StaticResource SeCobraryButtonStyle}" Width="90" Click="BrowseTerminalButton_Click"/>
                                </Grid>

                                <!-- external editor -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="FileCode" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="External Editor" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Fallback external editor" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="ExternalEditorText" Text="{Binding ExternalEditor, Mode=TwoWay}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,10,0" TextChanged="GenericSetting_Changed"/>
                                    <Button Grid.Column="2" x:Name="BrowseExternalEditorButton" Content="Browse..." Style="{StaticResource SeCobraryButtonStyle}" Width="90" Click="BrowseExternalEditorButton_Click"/>
                                </Grid>

                                <!-- build tool -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Hammer" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Build Tool" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Default build tool" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="BuildToolCombo" Style="{StaticResource ModernComboBoxStyle}" SelectedValue="{Binding BuildTool, Mode=TwoWay}" SelectedValuePath="Content" SelectionChanged="GenericSetting_Changed">
                                        <ComboBoxItem Content="PyInstaller"/>
                                        <ComboBoxItem Content="cx_Freeze"/>
                                        <ComboBoxItem Content="Nuitka"/>
                                        <ComboBoxItem Content="Py2exe"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- extensions section -->
                    <StackPanel x:Name="ExtensionsSection" Visibility="Collapsed">
                        <TextBlock Text="Extensions" Style="{StaticResource SectionHeaderStyle}"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <!-- installed extensions -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Puzzle" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Manage Extensions" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Browse and install extensions" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Open Extension Manager" Style="{StaticResource PrimaryButtonStyle}" Width="160" Click="OpenExtensionManagerButton_Click"/>
                                </Grid>

                                <!-- installed extensions list -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="PackageVariant" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Installed" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Currently installed extensions" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1e1e1e" CornerRadius="3" Padding="10" Margin="0,0,0,0">
                                        <StackPanel>
                                            <CheckBox Content="Python Language Support" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}"/>
                                            <CheckBox Content="Pygame-ce Snippets" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}"/>
                                            <CheckBox Content="Git Integration" IsChecked="False" Style="{StaticResource ModernCheckBoxStyle}"/>
                                            <CheckBox Content="Theme Pack - Monokai" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- keymap section -->
                    <StackPanel x:Name="KeymapSection" Visibility="Collapsed">
                        <TextBlock Text="Keymap" Style="{StaticResource SectionHeaderStyle}"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <!-- keymap preset -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Keyboard" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Keymap Preset" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Keyboard shortcut scheme" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="KeymapCombo" Style="{StaticResource ModernComboBoxStyle}" SelectedValue="{Binding KeymapPreset, Mode=TwoWay}" SelectedValuePath="Content" SelectionChanged="GenericSetting_Changed">
                                        <ComboBoxItem Content="Cobra Default"/>
                                        <ComboBoxItem Content="VS Code"/>
                                        <ComboBoxItem Content="Sublime Text"/>
                                        <ComboBoxItem Content="Visual Studio"/>
                                        <ComboBoxItem Content="Emacs"/>
                                        <ComboBoxItem Content="Vim"/>
                                    </ComboBox>
                                </Grid>

                                <!-- custom keybindings -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Tune" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                            <TextBlock Text="Custom Keybindings" Style="{StaticResource SettingLabelStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Edit custom shortcuts" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Edit Keybindings" Style="{StaticResource SeCobraryButtonStyle}" Width="120" Click="EditKeybindingsButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- about section -->
                    <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                        <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <!-- version info -->
                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="InformationOutline" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                        <TextBlock Text="Version" Style="{StaticResource SettingLabelStyle}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="2.0.0" Foreground="#4ec9b0" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Calendar" Width="14" Height="14" Foreground="#888888" Margin="0,0,5,0"/>
                                        <TextBlock Text="Build Date" Style="{StaticResource SettingLabelStyle}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="2026" Foreground="#e0e0e0" FontSize="12"/>
                                </Grid>

                                <!-- action buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Content="Check for Updates" Style="{StaticResource PrimaryButtonStyle}" Width="140" Margin="0,0,10,0" Click="CheckNowButton_Click"/>
                                    <Button Content="View License" Style="{StaticResource SeCobraryButtonStyle}" Width="120" Margin="0,0,10,0" Click="ViewLicenseButton_Click"/>
                                    <Button Content="Report Issue" Style="{StaticResource SeCobraryButtonStyle}" Width="120" Click="ReportIssueButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- bottom action buttons -->
                <Border Background="#252526" CornerRadius="3" Padding="20,15" Margin="0,30,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ResetButton" Content="Reset to Defaults" Style="{StaticResource SeCobraryButtonStyle}" Width="130" Margin="0,0,10,0" Click="ResetButton_Click"/>
                        <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SeCobraryButtonStyle}" Width="100" Margin="0,0,10,0" Click="CancelButton_Click"/>
                        <Button x:Name="ApplyButton" Content="Apply Changes" Style="{StaticResource PrimaryButtonStyle}" Width="120" Click="ApplyButton_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>
</Page>
    
