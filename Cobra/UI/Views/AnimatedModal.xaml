<Window x:Class="Cobra.UI.Views.AnimatedModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        MinWidth="500"
        MaxWidth="800">

    <Window.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
    </Window.RenderTransform>

    <Grid>
        <!-- overlay background -->
        <Border Background="#09090b" Opacity="0.6"/>

        <!-- modal content with floating shadow effect -->
        <Border Background="#202024" 
                CornerRadius="8"
                BorderBrush="#383840" 
                BorderThickness="1"
                Width="700"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" 
                                Opacity="0.55" 
                                ShadowDepth="8"
                                Direction="270"
                                Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- title bar -->
                <Border Grid.Row="0" 
                        Background="#18181b" 
                        CornerRadius="8,8,0,0"
                        BorderBrush="#2e2e33"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial x:Name="TitleIcon" 
                                                        Kind="FolderPlus" 
                                                        Width="14" 
                                                        Height="14" 
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="#cccccc"/>
                            <TextBlock x:Name="TitleText" 
                                    Text="New Project" 
                                    Foreground="White" 
                                    FontSize="12" 
                                    Margin="4"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button x:Name="CloseButton"
                                HorizontalAlignment="Right"
                                Width="30"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Border" Background="Transparent" CornerRadius="3">
                                        <iconPacks:PackIconMaterial Kind="Close" 
                                                                   Width="14" 
                                                                   Height="14" 
                                                                   Foreground="#cccccc"
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#c42b1c"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- content area -->
                <Border Grid.Row="1" Background="#202024" Padding="16">
                    <StackPanel x:Name="ContentPanel">
                        <!-- content will be added here -->
                    </StackPanel>
                </Border>

                <!-- button area -->
                <Border Grid.Row="2" 
                        Background="#18181b" 
                        CornerRadius="0,0,8,8"
                        BorderBrush="#2e2e33"
                        BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- buttons will be added here -->
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
    
