# Application & Environment 
COBRA_ENV=development
COBRA_APP_NAME="Cobra IDE"
COBRA_VERSION=2.0.0
COBRA_THEME=Dark
COBRA_ACCENT_COLOR=#FF8C00
COBRA_LOG_LEVEL=Information

# Python & Virtual Environment Defaults
COBRA_DEFAULT_PYTHON=python
COBRA_AUTO_CREATE_VENV=true
COBRA_DEFAULT_FRAMEWORK=Pygame
COBRA_SUPPORTED_FRAMEWORKS=Pygame,Panda3D,Ursina
COBRA_PIP_INDEX_URL=https://pypi.org/simple
COBRA_DEFAULT_PACKAGES=pygame-ce,pymunk,numpy,pillow,pyinstaller,debugpy,ruff,pytest
COBRA_PYTHONUNBUFFERED=1

# Game Engine & Viewport Configuration 
COBRA_DEFAULT_RESOLUTION=1280x720
COBRA_TARGET_FPS=60
COBRA_VSYNC_ENABLED=true
COBRA_PHYSICS_ENGINE=Pymunk2D
COBRA_GRID_SNAP_ENABLED=true
COBRA_GRID_SNAP_SIZE=32
COBRA_SHOW_COLLISION_GIZMOS=true
COBRA_ENABLE_3D_VIEWPORT=true

# Build & Packaging
COBRA_BUILD_TOOL=PyInstaller
COBRA_BUILD_MODE=Release
COBRA_BUILD_ONEFILE=true
COBRA_BUILD_WINDOWED=true
COBRA_BUILD_CLEAN=true

# --- Security & Sandbox ---
COBRA_MAX_ASSET_SIZE_MB=100
COBRA_ALLOW_UNTRUSTED_PLUGINS=false
COBRA_WEBVIEW2_STRICT_CSP=true
COBRA_TELEMETRY_ENABLED=false

# optional AI Assistant Integration 
COBRA_AI_ENABLED=false
COBRA_AI_CONSENT_GRANTED=false
COBRA_AI_PROVIDER=OpenAI_Compatible
COBRA_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
COBRA_AI_MODEL=gpt-4o-mini
COBRA_AI_API_KEY=your_api_key_here

